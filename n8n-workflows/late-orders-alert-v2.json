    "supabaseApi": {
     "id": "VHsYNeTKPn9mDuQF",
     "name": "Supabase"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// الأوردرات اللي فاضل على وقتها 10 دقايق أو أقل، ولسه متبعتلهاش تنبيه\nconst now = Date.now();\nconst out = [];\n\nfor (const x of $input.all()) {\n  const o = x.json;\n  if (!o || !o.id || !o.businesses) continue;\n  const b = o.businesses;\n\n  const isPickup = o.order_type === 'pickup';\n  const expected = isPickup ? (Number(b.pickup_minutes) || 20) : (Number(b.delivery_minutes) || 45);\n  const mins = Math.round((now - new Date(o.created_at).getTime()) / 60000);\n\n  if (mins >= expected - 10) {\n    const num = o.daily_number || o.id;\n    out.push({\n      json: {\n        order_id: o.id,\n        business_id: o.business_id,\n        sender_id: o.sender_id || null,\n        customer_name: o.customer_name || null,\n        customer_phone: o.phone || null,\n        chat: b.telegram_chat || '',\n        title: 'أوردر رقم ' + num + ' قرب يعدّي وقته',\n        text: '⏰ أوردر رقم ' + num + ' قرب يعدّي وقته\\n\\n' +\n              '👤 ' + (o.customer_name || '') + ' - 📞 ' + (o.phone || '') + '\\n' +\n              (isPickup ? '🏪 استلام' : '🚚 توصيل') + ' | اتعمل من ' + mins + ' دقيقة (المعتاد ' + expected + ')\\n\\n' +\n              (o.order_items || '')\n      }\n    });\n  }\n}\n\nreturn out;\n"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    272,
    16
   ],
   "id": "b9fb25ad-7a29-471b-95c0-c0e864b5a56d",
