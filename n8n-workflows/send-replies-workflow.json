   "parameters": {
    "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const r = it.json;\n  const last = r.last_msg ? new Date(r.last_msg).getTime() : 0;\n  const ageH = (Date.now() - last) / 3600000;\n  out.push({ json: {\n    id: r.id,\n    page_token: r.page_token,\n    sender_id: r.sender_id,\n    text: String(r.text || '').slice(0, 1800),\n    canSend: !!last && ageH < 23.5\n  } });\n}\nreturn out;"
   },
