   "parameters": {
    "jsCode": "const src = $('Decide').item.json;\nconst failed = !!($json.error || !$json.message_id);\nreturn { json: {\n  id: src.id,\n  status: failed ? 'failed' : 'sent',\n  sent_at: failed ? null : new Date().toISOString(),\n  error: failed ? JSON.stringify($json.error || $json).slice(0, 500) : null\n} };",
    "mode": "runOnceForEachItem"
